[Unit]
Description=A simple daemon for sms redirection
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/telepuz/smsmanager

[Service]
Type=simple
ExecStart=/usr/bin/smsmanager
PIDFile=/run/smsmanager/smsmanager.pid
TimeoutStopSec=0
Restart=always
RestartSec=10
RuntimeDirectory=smsmanager
RuntimeDirectoryMode=2755
UMask=007

[Install]
WantedBy=multi-user.target
